# ═══════════════════════════════════════════════════════════
# AI 신문고 환경변수 예시
# 사용법:
#   백엔드 → backend/.env 에 아래 항목 복사 (NEXT_PUBLIC_* 제외)
#   프론트 → frontend/.env.local 에 NEXT_PUBLIC_* 항목만 복사
# ═══════════════════════════════════════════════════════════

# ── LLM API ──────────────────────────────────────────────────
# OpenAI API 키 — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...여기에-OpenAI-키-입력...
# Anthropic API 키 — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...여기에-Anthropic-키-입력...
# 기본 백엔드 LLM 모델
BACKEND_MODEL=gpt-4o-mini

# ── 데이터베이스 ──────────────────────────────────────────────
# 로컬 개발 (SQLite) — backend/ 디렉토리 기준 경로
DATABASE_URL=sqlite:///./data/app.db
# 프로덕션 (Railway PostgreSQL / Neon 등)
# DATABASE_URL=postgresql://user:password@host:5432/sinmungo

# ── 외부 API ─────────────────────────────────────────────────
# 국가법령정보센터 Open API — https://open.law.go.kr
LAW_API_KEY=여기에-국가법령정보센터-API-키-입력
# Tavily 웹 검색 API — https://app.tavily.com/home
TAVILY_API_KEY=tvly-dev-...여기에-Tavily-키-입력...

# ── ML 모델 ──────────────────────────────────────────────────
# KoBERT 가결 예측 활성화 여부 (false = 메모리 절약, 휴리스틱으로 fallback)
ML_ENABLE_KOBERT=true
# HuggingFace 모델 캐시 경로 (빈 값 = 기본 ~/.cache/huggingface)
HUGGINGFACE_CACHE_DIR=
# Whisper STT 모델 크기 (tiny / base / small / medium / large)
WHISPER_MODEL_SIZE=base

# ── 관리자 보안 ───────────────────────────────────────────────
# 관리자 API 보호 키 (빈 값 = 인증 미적용 — 개발 환경에서만 허용)
ADMIN_API_KEY=원하는-관리자-비밀키-입력

# ── 프론트엔드 (Next.js) ──────────────────────────────────────
# 백엔드 API 기본 URL (프론트엔드 전용 — frontend/.env.local에 작성)
NEXT_PUBLIC_API_URL=http://localhost:8001

# ── 서버 설정 ────────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8001
